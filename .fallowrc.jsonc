{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// src/worker/index.ts is the Worker, which wrangler.toml names as main.
	"entry": ["src/worker/index.ts", "scripts/*.ts"],
	// mise installs oxfmt-next-line; see .mise/config.toml.
	"ignoreBinaries": ["oxfmt-next-line"],
	"rules":
	{
		"unused-dependencies": "error",
	},
}
